# Postgres connection string. On Render, use the internal URL when the
# database is co-located with the service.
DATABASE_URL=postgres://user:pass@localhost:5432/tuitio?sslmode=disable

# Soroban RPC endpoint.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Deployed contract addresses (see tuitio-contract/deployments/testnet.json).
REGISTRY_CONTRACT=CD2INHSYNIQTVWM222CNSS7MN4MJSOBZOXVEWY3SOAK6MHICCZIEVQWV
ESCROW_CONTRACT=CDV7FA3QJPBR7LORHCZCZG6UCRL7DMXVMZYRDLMW7EXUNBMN7SEXINXW

# Ledger to begin indexing from. 0 means start at the current latest ledger
# and skip history. Set to a ledger before the first tracked event to
# backfill.
START_LEDGER=0

# Indexer poll interval in seconds.
POLL_SECONDS=10

# HTTP port.
PORT=8080
